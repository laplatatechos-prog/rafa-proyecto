<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_fondo" android:padding="12dp">
    <LinearLayout android:id="@+id/w_texto" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/w_linea1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/texto" android:textSize="16sp" android:textStyle="bold"
            android:maxLines="2" android:ellipsize="end" android:text="Mi Día" />
        <TextView android:id="@+id/w_linea2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/suave" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
            android:text="Tocá 🎙️ para agregar" />
    </LinearLayout>
    <ImageButton android:id="@+id/w_mic" android:layout_width="64dp" android:layout_height="64dp"
        android:background="@drawable/widget_mic" android:src="@drawable/ic_mic" android:scaleType="center"
        android:contentDescription="Agregar por voz" />
</LinearLayout>
