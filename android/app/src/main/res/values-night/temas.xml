<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:colorPrimary">@color/acento</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Tema.Dialogo" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
